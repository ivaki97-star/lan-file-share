# Copy to .env next to server.js. Every line is optional; without a .env the site runs as a LAN party share.
# lan (default): no accounts, the host PC is the admin.  hosted: accounts required, admin by role.
MODE=hosted
# Accounts on/off (hosted defaults to on, lan to off). Hosted without accounts is not recommended.
AUTH=on
# Port and bind address. Behind Caddy/nginx bind to 127.0.0.1.
PORT=8080
BIND=127.0.0.1
# Keep the data outside the git checkout on a server.
DATA_DIR=/var/lib/lan-file-share
# The address players use. Written into the installer so it can reach the site from anywhere.
PUBLIC_URL=https://share.example.com
# Needed to register. Give it to your group, change it to close registration.
INVITE_CODE=change-me
# Long random string. The deploy command on the Minecraft server authenticates with it.
ADMIN_TOKEN=change-me-too
# on when a reverse proxy sits in front (uses X-Forwarded-For for the log, disables "host PC = admin").
TRUST_PROXY=on
